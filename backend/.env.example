PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
# Optional comma-separated list of additional allowed CORS origins, e.g. your
# Mac's LAN IP for testing QR check-in from a phone on the same WiFi.
CORS_EXTRA_ORIGINS=

# Postgres connection string (Supabase: Project Settings -> Database -> Connection string -> URI, Direct connection)
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Random secret used to sign session JWTs, e.g. `openssl rand -hex 32`
SESSION_SECRET=

# Comma-separated list of board member emails allowed to use admin routes
ADMIN_EMAILS=

# From Google Cloud Console OAuth Client ID (set up in step 5)
GOOGLE_CLIENT_ID=
